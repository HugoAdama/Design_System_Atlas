---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "La arquitectura invisible de cada pantalla | Atlas de diseño",
  description = "Una guía de consulta permanente sobre design systems, arquitectura de información, patrones frontend y tendencias visuales."
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    
    <!-- Open Graph & Twitter Cards -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://hugoadama.github.io/Design_System_Atlas/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://hugoadama.github.io/Design_System_Atlas/og-image.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://hugoadama.github.io/Design_System_Atlas/og-image.jpg" />

    <title>{title}</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..800;1,6..96,400..800&family=Hanken+Grotesk:wght@400;500;700&display=swap"
    />

    <!-- Theme & Language persistence script (prevents FOUC) -->
    <script is:inline>
      (function() {
        try {
          const storedTheme = localStorage.getItem('theme');
          if (storedTheme) {
            document.documentElement.setAttribute('data-theme', storedTheme);
          }
          const storedLang = localStorage.getItem('atlas_lang');
          if (storedLang) {
            document.documentElement.lang = storedLang;
          } else if (navigator.language && navigator.language.startsWith('en')) {
            document.documentElement.lang = 'en';
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body>
    <div class="paper-grain" aria-hidden="true"></div>
    <slot />
  </body>
</html>
