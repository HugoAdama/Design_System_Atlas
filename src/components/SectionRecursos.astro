---

<section class="ch" id="recursos">
  <div class="side reveal-on-scroll">
    <h2 data-i18n="recursos.title">Recursos, blogs y herramientas</h2>
    <p data-i18n="recursos.subtitle">La seccion a la que se vuelve. Enlaces contrastados y actualizados con especificaciones vivas para el trabajo diario.</p>
  </div>
  <div class="body">
    <div class="resource-tabs reveal-on-scroll" role="tablist" aria-label="Filtrar por categoria">
      <button type="button" class="resource-tab-btn" data-cat="all" aria-selected="true">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        </svg>
        <span data-i18n="recursos.tab.all">Todos</span>
      </button>
      <button type="button" class="resource-tab-btn" data-cat="specs" aria-selected="false">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <polyline points="16 18 22 12 16 6"></polyline>
          <polyline points="8 6 2 12 8 18"></polyline>
        </svg>
        <span data-i18n="recursos.tab.specs">Especificaciones W3C</span>
      </button>
      <button type="button" class="resource-tab-btn" data-cat="tools" aria-selected="false">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
          <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
        </svg>
        <span data-i18n="recursos.tab.tools">Herramientas</span>
      </button>
      <button type="button" class="resource-tab-btn" data-cat="ux" aria-selected="false">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <span data-i18n="recursos.tab.ux">UX & Usabilidad</span>
      </button>
      <button type="button" class="resource-tab-btn" data-cat="blogs" aria-selected="false">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
          <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
        </svg>
        <span data-i18n="recursos.tab.blogs">Publicaciones</span>
      </button>
    </div>

    <ul id="resource-list" class="resources-grid reveal-on-scroll">
      {resources.map((item) => (
        <li class="resource-item" data-category={item.cat}>
          <a
            href={item.url}
            target="_blank"
            rel="noopener noreferrer"
            class="resource-card-link"
          >
            <div class="resource-card-top">
              <span class="resource-cat-pill">{item.catLabel}</span>
              <svg class="resource-link-arrow" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </div>
            <h3 class="resource-name">{item.name}</h3>
            <p class="resource-desc">{item.desc}</p>
            <div class="resource-card-bottom">
              <span class="resource-tag-pill">{item.tag}</span>
            </div>
          </a>
        </li>
      ))}
    </ul>

    <ChapterPagination
      prevId="tendencias"
      prevTitleKey="nav.tendencias"
      prevDefault="Tendencias"
    />
  </div>
</section>

<script>
  function setupResourceFilter() {
    const tabs = document.querySelectorAll('.resource-tab-btn');
    const items = document.querySelectorAll('.resource-item');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => t.setAttribute('aria-selected', 'false'));
        tab.setAttribute('aria-selected', 'true');

        const cat = (tab as HTMLElement).dataset.cat;
        items.forEach((it) => {
          const itemEl = it as HTMLElement;
          const match = cat === 'all' || itemEl.dataset.category === cat;
          itemEl.classList.toggle('is-hidden', !match);
        });
      });
    });
  }

  setupResourceFilter();
  document.addEventListener('astro:page-load', setupResourceFilter);
</script>
