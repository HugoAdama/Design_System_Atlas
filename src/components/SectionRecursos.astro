---
import ChapterPagination from './ChapterPagination.astro';

interface ResourceItem {
  cat: 'specs' | 'tools' | 'ux' | 'blogs';
  catLabel: string;
  name: string;
  desc: string;
  tag: string;
  url: string;
}

const resources: ResourceItem[] = [
  // Especificaciones
  {
    cat: "specs",
    catLabel: "Especificacion",
    name: "W3C Design Tokens Community Group",
    desc: "Especificacion tecnica oficial para el formato de intercambio e interoperabilidad de tokens (DTCG).",
    tag: "W3C DTCG Format",
    url: "https://design-tokens.github.io/community-group/format/"
  },
  {
    cat: "specs",
    catLabel: "Especificacion",
    name: "WAI-ARIA Authoring Practices Guide (APG)",
    desc: "Patrones de diseno accesibles, roles semanticos y comportamientos de teclado recomendados por el W3C.",
    tag: "Accesibilidad W3C",
    url: "https://www.w3.org/WAI/ARIA/apg/"
  },
  {
    cat: "specs",
    catLabel: "Especificacion",
    name: "Open Props",
    desc: "Super-conjunto de tokens y variables CSS estandar aceleradas por GPU, listas para produccion.",
    tag: "Tokens CSS",
    url: "https://open-props.style/"
  },
  
  // Herramientas
  {
    cat: "tools",
    catLabel: "Herramienta",
    name: "zeroheight",
    desc: "Plataforma centralizada para sincronizar y documentar sistemas de diseno conectados con Figma y codigo.",
    tag: "Documentacion",
    url: "https://zeroheight.com"
  },
  {
    cat: "tools",
    catLabel: "Herramienta",
    name: "Storybook",
    desc: "Taller interactivo para construir, aislar y testear componentes UI fuera de la logica de negocio.",
    tag: "Taller UI",
    url: "https://storybook.js.org"
  },
  {
    cat: "tools",
    catLabel: "Herramienta",
    name: "Subframe",
    desc: "IDE visual para disenar interfaces modernas de alta fidelidad que genera codigo limpio en Tailwind.",
    tag: "Diseno a Codigo",
    url: "https://www.subframe.com"
  },
  {
    cat: "tools",
    catLabel: "Herramienta",
    name: "Lucide Icons",
    desc: "Libreria de iconos SVG limpios, consistentes y modulares con mas de 1.400 glifos configurables.",
    tag: "Iconografia SVG",
    url: "https://lucide.dev"
  },
  {
    cat: "tools",
    catLabel: "Herramienta",
    name: "Tailwind CSS",
    desc: "Framework CSS de utilidades atomicas con soporte de tokens de diseno y optimizacion de compilacion.",
    tag: "CSS Framework",
    url: "https://tailwindcss.com"
  },
  {
    cat: "tools",
    catLabel: "Herramienta",
    name: "Radix UI Primitives",
    desc: "Componentes headless sin estilos con maxima accesibilidad WAI-ARIA y control total de estilos.",
    tag: "Headless UI",
    url: "https://www.radix-ui.com"
  },

  // UX & Arquitectura
  {
    cat: "ux",
    catLabel: "UX & Usabilidad",
    name: "Laws of UX (Jon Yablonski)",
    desc: "Compilacion de leyes y principios de psicologia cognitiva fundamentales aplicados a la interaccion digital.",
    tag: "Principios Cognitivos",
    url: "https://lawsofux.com"
  },
  {
    cat: "ux",
    catLabel: "UX & Usabilidad",
    name: "Optimal Workshop",
    desc: "Herramientas de investigacion y testeo de arquitectura de informacion mediante card sorting y tree testing.",
    tag: "Arquitectura Info",
    url: "https://www.optimalworkshop.com"
  },
  {
    cat: "ux",
    catLabel: "UX & Usabilidad",
    name: "Maze User Testing",
    desc: "Plataforma de pruebas continuas con prototipos dinamicos para recopilar metricas cuantitativas de usuario.",
    tag: "User Testing",
    url: "https://maze.co"
  },
  {
    cat: "ux",
    catLabel: "UX & Usabilidad",
    name: "Nielsen Norman Group",
    desc: "Lider mundial en investigacion empirica de usabilidad, heuristicas de diseno y experiencia de usuario.",
    tag: "Investigacion UX",
    url: "https://www.nngroup.com"
  },

  // Blogs y Referencias
  {
    cat: "blogs",
    catLabel: "Publicacion",
    name: "Smashing Magazine",
    desc: "Articulos editoriales de profundidad sobre arquitectura frontend, accesibilidad y rendimiento web.",
    tag: "Arquitectura Web",
    url: "https://www.smashingmagazine.com"
  },
  {
    cat: "blogs",
    catLabel: "Publicacion",
    name: "CSS-Tricks",
    desc: "Almanaque canonico de tecnicas de maquetacion, selectores modernos, flexbox, CSS Grid y animaciones.",
    tag: "Almanaque CSS",
    url: "https://css-tricks.com"
  },
  {
    cat: "blogs",
    catLabel: "Publicacion",
    name: "Codrops",
    desc: "Laboratorio y escaparate experimental de interaccion UI, transiciones visuales, shaders y Canvas.",
    tag: "Interaccion Web",
    url: "https://tympanus.net/codrops"
  },
  {
    cat: "blogs",
    catLabel: "Publicacion",
    name: "A List Apart",
    desc: "Publicacion pionera sobre diseno centrado en estandares web abiertos, tipografia editorial y contenido.",
    tag: "Diseno Editorial",
    url: "https://alistapart.com"
  },
  {
    cat: "blogs",
    catLabel: "Publicacion",
    name: "Figma Design Systems Blog",
    desc: "Casos practicos, arquitectura de variables y metodologias de gestion de sistemas a escala empresarial.",
    tag: "Casos de Estudio",
    url: "https://www.figma.com/blog"
