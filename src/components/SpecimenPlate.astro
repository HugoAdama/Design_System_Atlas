---
// Interactive design token specimen playground 2.0 with multi-format export
---

<figure class="reveal-on-scroll">
  <div class="plate">
    <div class="spec" id="spec">
      <h4>Boletín del atlas</h4>
      <p>Una carta al mes, sin ruido ni algoritmos.</p>
      <div class="r">
        <span class="inp">correo@ejemplo.com</span>
        <button class="btn" type="button">Suscribirme</button>
      </div>
      <span class="tag">Gratis</span>
    </div>

    <div class="ctrl">
      <!-- Color de acción -->
      <fieldset>
        <legend>Color de acción (--t-accent)</legend>
        <div class="opts" data-k="--t-accent">
          <button
            class="dot"
            type="button"
            aria-label="Cobalto Suizo"
            aria-pressed="true"
            data-v="#0047ff"
            style="background:#0047ff"
          ></button>
          <button
            class="dot"
            type="button"
            aria-label="Azul Noche"
            aria-pressed="false"
            data-v="#0f172a"
            style="background:#0f172a"
          ></button>
          <button
            class="dot"
            type="button"
            aria-label="Esmeralda"
            aria-pressed="false"
            data-v="#059669"
            style="background:#059669"
          ></button>
          <button
            class="dot"
            type="button"
            aria-label="Ámbar Técnico"
            aria-pressed="false"
            data-v="#f59e0b"
            style="background:#f59e0b"
          ></button>
        </div>
      </fieldset>

      <!-- Esquinas / Radio -->
      <fieldset>
        <legend>Esquinas (--t-radius)</legend>
        <div class="opts" data-k="--t-radius">
          <button type="button" aria-pressed="false" data-v="0px">Rectas</button>
          <button type="button" aria-pressed="true" data-v="8px">Suaves</button>
          <button type="button" aria-pressed="false" data-v="999px">Píldora</button>
        </div>
      </fieldset>

      <!-- Espaciado -->
      <fieldset>
        <legend>Espacio (--t-space)</legend>
        <div class="opts" data-k="--t-space">
          <button type="button" aria-pressed="false" data-v="10px">10px</button>
          <button type="button" aria-pressed="true" data-v="16px">16px</button>
          <button type="button" aria-pressed="false" data-v="24px">24px</button>
        </div>
      </fieldset>

      <!-- Elevación y Sombra -->
      <fieldset>
        <legend>Elevación (--t-shadow)</legend>
        <div class="opts" data-k="--t-shadow">
          <button type="button" aria-pressed="false" data-v="none">Plana</button>
          <button type="button" aria-pressed="true" data-v="0 4px 12px rgba(20,32,28,0.08)">Sutil</button>
          <button type="button" aria-pressed="false" data-v="0 16px 32px -4px rgba(20,32,28,0.22)">Flotante</button>
          <button type="button" aria-pressed="false" data-v="5px 5px 0 #14201c">Dura</button>
        </div>
      </fieldset>

      <!-- Tipografía del espécimen -->
      <fieldset style="margin:0">
        <legend>Tipografía (--t-font)</legend>
        <div class="opts" data-k="--t-font">
          <button type="button" aria-pressed="true" data-v="var(--sans)">Sans</button>
          <button type="button" aria-pressed="false" data-v="var(--serif)">Serif</button>
        </div>
      </fieldset>

      <!-- Pestañas de Formato de Exportación -->
      <div class="spec-copy-row">
        <div class="export-tabs" role="tablist" aria-label="Formato de exportación">
          <button type="button" class="export-tab-btn" data-fmt="css" aria-selected="true">CSS</button>
          <button type="button" class="export-tab-btn" data-fmt="tailwind" aria-selected="false">Tailwind v4</button>
          <button type="button" class="export-tab-btn" data-fmt="json" aria-selected="false">W3C JSON</button>
        </div>

        <button type="button" id="copy-spec-tokens" class="copy-tokens-btn">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span id="copy-spec-label">Copiar en CSS</span>
        </button>
      </div>
    </div>
  </div>

  <figcaption>
    <b>Figura 1. Playground de tokens.</b> Cinco tokens gobernantes (color de acento, radio de borde, escala espacial, sombra y tipografía) modifican en tiempo real la personalidad del componente.
  </figcaption>
</figure>

<script>
  function setupSpecimenControls() {
    const sp = document.getElementById('spec');
    if (!sp) return;

    // Track active values
    const currentTokens: Record<string, string> = {
      '--t-accent': '#0047ff',
      '--t-radius': '8px',
      '--t-space': '16px',
      '--t-shadow': '0 4px 14px rgba(0,71,255,0.08)',
      '--t-font': 'var(--sans)'
    };

    let activeFormat = 'css';

    document.querySelectorAll('.opts').forEach((g) => {
      g.addEventListener('click', (e) => {
        const target = e.target as HTMLElement | null;
        const b = target ? target.closest('button') : null;
        if (!b) return;

        const group = g as HTMLElement;
        group.querySelectorAll('button').forEach((x) => {
          x.setAttribute('aria-pressed', String(x === b));
        });

        const key = group.dataset.k;
        const val = b.dataset.v;
        if (key && val) {
          sp.style.setProperty(key, val);
          currentTokens[key] = val;
        }
      });
    });

    // Format selection handler
    const formatBtns = document.querySelectorAll('.export-tab-btn');
    const copyLabel = document.getElementById('copy-spec-label');

    formatBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        formatBtns.forEach((b) => b.setAttribute('aria-selected', 'false'));
        btn.setAttribute('aria-selected', 'true');
        activeFormat = (btn as HTMLElement).dataset.fmt || 'css';
        if (copyLabel) {
          if (activeFormat === 'css') copyLabel.textContent = 'Copiar en CSS';
          if (activeFormat === 'tailwind') copyLabel.textContent = 'Copiar en Tailwind v4';
          if (activeFormat === 'json') copyLabel.textContent = 'Copiar en W3C JSON';
        }
      });
    });

    // Copy tokens button handler
    const copyBtn = document.getElementById('copy-spec-tokens');
    if (copyBtn && copyLabel) {
      copyBtn.addEventListener('click', async () => {
        let text = '';
        if (activeFormat === 'css') {
          text = `:root {\n  --t-accent: ${currentTokens['--t-accent']};\n  --t-radius: ${currentTokens['--t-radius']};\n  --t-space: ${currentTokens['--t-space']};\n  --t-shadow: ${currentTokens['--t-shadow']};\n  --t-font: ${currentTokens['--t-font']};\n}`;
        } else if (activeFormat === 'tailwind') {
          text = `@theme {\n  --color-accent: ${currentTokens['--t-accent']};\n  --radius-custom: ${currentTokens['--t-radius']};\n  --spacing-base: ${currentTokens['--t-space']};\n  --shadow-card: ${currentTokens['--t-shadow']};\n}`;
        } else if (activeFormat === 'json') {
          text = JSON.stringify({
            token: {
              accent: { "$value": currentTokens['--t-accent'], "$type": "color" },
              radius: { "$value": currentTokens['--t-radius'], "$type": "dimension" },
              spacing: { "$value": currentTokens['--t-space'], "$type": "dimension" },
              shadow: { "$value": currentTokens['--t-shadow'], "$type": "shadow" }
            }
          }, null, 2);
        }

        try {
          await navigator.clipboard.writeText(text);
          const orig = copyLabel.textContent;
          copyLabel.textContent = "¡Tokens copiados!";
          setTimeout(() => {
            copyLabel.textContent = orig;
          }, 2000);
        } catch (_) {}
      });
    }
  }

  setupSpecimenControls();
  document.addEventListener('astro:page-load', setupSpecimenControls);
</script>
