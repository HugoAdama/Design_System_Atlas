---
interface Props {
  prevId?: string;
  prevTitleKey?: string;
  prevDefault?: string;
  nextId?: string;
  nextTitleKey?: string;
  nextDefault?: string;
}

const {
  prevId,
  prevTitleKey = '',
  prevDefault = '',
  nextId,
  nextTitleKey = '',
  nextDefault = '',
} = Astro.props;
---

<nav class="chapter-pagination" aria-label="Navegación entre capítulos">
  <div class="pagination-col prev">
    {prevId ? (
      <a href={`#${prevId}`} class="pagination-card prev-card" data-chapter-target={prevId}>
        <div class="pagination-arrow-wrap">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
        </div>
        <div class="pagination-text">
          <span class="pagination-label" data-i18n="nav.prev">Capítulo anterior</span>
          <span class="pagination-title" data-i18n={prevTitleKey}>{prevDefault}</span>
        </div>
      </a>
    ) : (
      <div class="pagination-spacer"></div>
    )}
  </div>

  <div class="pagination-col next">
    {nextId ? (
      <a href={`#${nextId}`} class="pagination-card next-card" data-chapter-target={nextId}>
        <div class="pagination-text align-right">
          <span class="pagination-label" data-i18n="nav.next">Siguiente capítulo</span>
          <span class="pagination-title" data-i18n={nextTitleKey}>{nextDefault}</span>
        </div>
        <div class="pagination-arrow-wrap">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </div>
      </a>
    ) : (
      <div class="pagination-spacer"></div>
    )}
  </div>
</nav>

<style>
  .chapter-pagination {
    display: flex;
    gap: 1.5rem;
    margin-top: 4rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .pagination-col {
    flex: 1;
    min-width: 0;
  }

  .pagination-spacer {
    height: 1px;
  }

  .pagination-card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.25rem 1.5rem;
    background: var(--paper-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    box-shadow: var(--card-shadow);
    transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.22s ease,
                box-shadow 0.22s ease;
  }

  .pagination-card:hover {
    transform: translateY(-3px);
    border-color: var(--cobalt);
    box-shadow: var(--card-shadow-hover);
  }

  .pagination-card.next-card {
    justify-content: flex-end;
  }

  .pagination-arrow-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--paper-2);
    border: 1px solid var(--border-subtle);
    color: var(--cobalt);
    flex-shrink: 0;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .pagination-card:hover .pagination-arrow-wrap {
    background: var(--rose-soft);
    transform: scale(1.08);
  }

  .prev-card:hover .pagination-arrow-wrap svg {
    transform: translateX(-2px);
  }

  .next-card:hover .pagination-arrow-wrap svg {
    transform: translateX(2px);
  }

  .pagination-arrow-wrap svg {
    width: 18px;
    height: 18px;
    stroke: currentColor;
    stroke-width: 2.2;
    fill: none;
    transition: transform 0.2s ease;
  }

  .pagination-text {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .pagination-text.align-right {
    text-align: right;
  }

  .pagination-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    color: var(--muted);
  }

  .pagination-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 640px) {
    .chapter-pagination {
      flex-direction: column;
      gap: 1rem;
    }

    .pagination-card.next-card {
      justify-content: flex-start;
      flex-direction: row-reverse;
    }

    .pagination-text.align-right {
      text-align: left;
    }
  }
</style>
