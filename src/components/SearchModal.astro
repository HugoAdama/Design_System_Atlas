---
import { searchIndex } from '../data';
---

<dialog id="search-dialog" class="search-dialog" aria-label="Buscador del Atlas">
  <div class="search-dialog-inner">
    <div class="search-input-wrapper">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        type="search"
        id="search-input"
        class="search-input"
        placeholder="Buscar conceptos, tokens, leyes de UX o patrones..."
        data-i18n-placeholder="search.placeholder"
        autocomplete="off"
        spellcheck="false"
      />
      <button type="button" id="search-close" class="search-close-btn" aria-label="Cerrar búsqueda">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <ul id="search-results" class="search-results-list" role="listbox">
      {searchIndex.map((item) => (
        <li
          class="search-item"
          data-title={item.title.toLowerCase()}
          data-title-en={item.titleEn?.toLowerCase() || ''}
          data-desc={item.desc.toLowerCase()}
          data-desc-en={item.descEn?.toLowerCase() || ''}
          data-section={item.section.toLowerCase()}
          data-section-en={item.sectionEn?.toLowerCase() || ''}
          data-tags={item.tags?.join(' ') || ''}
        >
          <a href={item.href} class="search-link">
            <span class="search-item-section">{item.section}</span>
            <span class="search-item-title">{item.title}</span>
            <span class="search-item-desc">{item.desc}</span>
          </a>
        </li>
      ))}
    </ul>

    <div class="search-footer-hint">
      <span data-i18n="search.hint.nav">Navegar con ↑ / ↓ &bull; Enter para abrir</span>
      <span data-i18n="search.hint.esc">ESC para cerrar</span>
    </div>
  </div>
</dialog>

<script>
  function setupSearch() {
    const dialog = document.getElementById('search-dialog') as HTMLDialogElement | null;
    const input = document.getElementById('search-input') as HTMLInputElement | null;
    const closeBtn = document.getElementById('search-close');
    const openBtns = document.querySelectorAll('.open-search-trigger');
    const items = document.querySelectorAll('.search-item');

    if (!dialog || !input) return;

    function openModal() {
      dialog?.showModal();
      input?.focus();
      input?.select();
    }

    function closeModal() {
      dialog?.close();
    }

    openBtns.forEach((btn) => btn.addEventListener('click', openModal));
    closeBtn?.addEventListener('click', closeModal);

    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) closeModal();
    });

    // Atajo global Ctrl+K o Cmd+K o '/'
    window.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (dialog.open) closeModal();
        else openModal();
      } else if (e.key === '/' && document.activeElement?.tagName !== 'INPUT' && document.activeElement?.tagName !== 'TEXTAREA') {
        e.preventDefault();
        openModal();
      }
    });

    // Filtro en vivo bilingüe y por etiquetas
    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      items.forEach((it) => {
        const el = it as HTMLElement;
        const title = el.dataset.title || '';
        const titleEn = el.dataset.titleEn || '';
        const desc = el.dataset.desc || '';
        const descEn = el.dataset.descEn || '';
        const section = el.dataset.section || '';
        const sectionEn = el.dataset.sectionEn || '';
        const tags = el.dataset.tags || '';
        const match =
          !q ||
          title.includes(q) ||
          titleEn.includes(q) ||
          desc.includes(q) ||
          descEn.includes(q) ||
          section.includes(q) ||
          sectionEn.includes(q) ||
          tags.includes(q);
        el.style.display = match ? 'block' : 'none';
      });
    });

    // Cerrar al hacer clic en un link
    dialog.querySelectorAll('.search-link').forEach((link) => {
      link.addEventListener('click', () => {
        closeModal();
      });
    });
  }

  setupSearch();
  document.addEventListener('astro:page-load', setupSearch);
</script>
