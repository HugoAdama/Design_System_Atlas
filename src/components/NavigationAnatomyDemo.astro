---
// Interactive visual demonstration of navigation models and empty states
---

<div class="nav-demo-wrapper reveal-on-scroll">
  <div class="nav-demo-header">
    <div class="nav-demo-tabs" role="tablist" aria-label="Modelos de navegacion visuales">
      <button type="button" class="nav-demo-tab is-active" data-model="topbar" role="tab" aria-selected="true">
        Top Bar (Header)
      </button>
      <button type="button" class="nav-demo-tab" data-model="sidebar" role="tab" aria-selected="false">
        Sidebar SaaS
      </button>
      <button type="button" class="nav-demo-tab" data-model="bottomnav" role="tab" aria-selected="false">
        Bottom Bar Movil
      </button>
      <button type="button" class="nav-demo-tab" data-model="emptystate" role="tab" aria-selected="false">
        Empty State
      </button>
    </div>
    <div class="nav-demo-meta">
      <span class="nav-demo-tag" id="nav-demo-tag">Resolucion: Escritorio &bull; 4 Destinos maximos</span>
    </div>
  </div>

  <div class="nav-stage" id="nav-stage">
    <!-- View 1: Top Bar Mockup -->
    <div class="stage-view stage-topbar is-visible" id="view-topbar">
      <div class="mockup-chrome">
        <span class="chrome-dot red"></span>
        <span class="chrome-dot yellow"></span>
        <span class="chrome-dot green"></span>
        <span class="chrome-address">https://app.atlas-design.internal/dashboard</span>
      </div>
      <div class="mockup-topbar">
        <div class="topbar-brand">
          <div class="topbar-logo-sq"></div>
          <span class="topbar-title">Atlas SaaS</span>
        </div>
        <div class="topbar-nav">
          <span class="topbar-link is-active">Panel</span>
          <span class="topbar-link">Proyectos</span>
          <span class="topbar-link">Metricas</span>
          <span class="topbar-link">Ajustes</span>
        </div>
        <div class="topbar-user">
          <div class="topbar-search-mock">
            <svg viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" fill="none"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <span>Buscar...</span>
          </div>
          <div class="topbar-avatar">AD</div>
        </div>
      </div>
      <div class="topbar-content-mock">
        <div class="mock-grid">
          <div class="mock-card h-large"></div>
          <div class="mock-card h-large"></div>
        </div>
      </div>
    </div>

    <!-- View 2: Sidebar SaaS Mockup -->
    <div class="stage-view stage-sidebar" id="view-sidebar">
      <div class="mockup-chrome">
        <span class="chrome-dot red"></span>
        <span class="chrome-dot yellow"></span>
        <span class="chrome-dot green"></span>
        <span class="chrome-address">https://cloud.designsystems.internal/workspace</span>
      </div>
      <div class="mockup-sidebar-layout">
        <div class="mock-sidebar">
          <div class="sidebar-header">
            <div class="topbar-logo-sq"></div>
            <span>DesignOps Hub</span>
          </div>
          <div class="sidebar-section-title">Colecciones</div>
          <div class="sidebar-item is-active">
            <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" fill="none"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
            <span>Tokens DTCG</span>
            <span class="sidebar-pill">v2.4</span>
          </div>
          <div class="sidebar-item">
            <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" fill="none"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
            <span>Componentes</span>
          </div>
          <div class="sidebar-item">
            <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" fill="none"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
            <span>Documentacion</span>
          </div>
          <div class="sidebar-section-title">Gobernanza</div>
          <div class="sidebar-item">
            <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" fill="none"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 14 14"></polyline></svg>
            <span>Revisiones (PRs)</span>
            <span class="sidebar-pill alert">3</span>
          </div>
        </div>
        <div class="mock-main-body">
          <div class="mock-banner"></div>
          <div class="mock-grid">
            <div class="mock-card"></div>
            <div class="mock-card"></div>
            <div class="mock-card"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- View 3: Mobile Bottom Navigation Mockup -->
    <div class="stage-view stage-bottomnav" id="view-bottomnav">
      <div class="phone-frame">
        <div class="phone-speaker"></div>
        <div class="phone-screen">
          <div class="phone-topbar">
            <span>9:41</span>
            <span>5G &bull; 100%</span>
          </div>
          <div class="phone-content">
            <div class="phone-hero-card">
              <span class="phone-tag">Biblioteca Activa</span>
              <h4>Design Tokens v2.0</h4>
              <p>Optimizados para pantallas tactiles con area minima de 48px.</p>
            </div>
            <div class="mock-card-sm"></div>
            <div class="mock-card-sm"></div>
          </div>
          <!-- Thumb reach zone & bottom bar -->
          <div class="phone-bottom-bar">
            <div class="phone-nav-item is-active">
              <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" fill="none"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
              <span>Inicio</span>
            </div>
            <div class="phone-nav-item">
              <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" fill="none"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
              <span>Buscar</span>
            </div>
            <div class="phone-nav-item">
              <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" fill="none"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
              <span>Alertas</span>
            </div>
            <div class="phone-nav-item">
              <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" fill="none"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
              <span>Perfil</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- View 4: Empty State Mockup -->
    <div class="stage-view stage-emptystate" id="view-emptystate">
      <div class="empty-state-card">
        <div class="empty-state-illustration">
          <svg viewBox="0 0 80 80" width="80" height="80" fill="none" aria-hidden="true">
            <circle cx="40" cy="40" r="36" stroke="var(--border)" stroke-width="2" stroke-dasharray="4 4"></circle>
            <rect x="24" y="24" width="32" height="32" rx="6" fill="var(--paper-2)" stroke="var(--cobalt)" stroke-width="2"></rect>
            <line x1="32" y1="36" x2="48" y2="36" stroke="var(--muted)" stroke-width="2" stroke-linecap="round"></line>
            <line x1="32" y1="44" x2="42" y2="44" stroke="var(--muted)" stroke-width="2" stroke-linecap="round"></line>
            <circle cx="54" cy="54" r="10" fill="var(--paper-card)" stroke="var(--cobalt)" stroke-width="2"></circle>
            <line x1="54" y1="50" x2="54" y2="58" stroke="var(--cobalt)" stroke-width="2" stroke-linecap="round"></line>
            <line x1="50" y1="54" x2="58" y2="54" stroke="var(--cobalt)" stroke-width="2" stroke-linecap="round"></line>
          </svg>
        </div>
        <h4>Sin especificaciones creadas todavia</h4>
        <p>No se encontraron tokens registrados en este espacio de trabajo. Puedes importar un archivo W3C DTCG en formato JSON o inicializar con la paleta suiza.</p>
        <div class="empty-state-actions">
          <button type="button" class="btn-empty-primary">Importar JSON de tokens</button>
          <button type="button" class="btn-empty-secondary">Ver documentacion</button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .nav-demo-wrapper {
    margin: 2rem 0;
    background: var(--paper-card);
    border: 1px solid var(--border);
    border-radius: 14px;
    box-shadow: var(--card-shadow);
    overflow: hidden;
  }

  .nav-demo-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1.25rem;
    background: var(--paper-2);
    border-bottom: 1px solid var(--border-subtle);
    gap: 1rem;
    flex-wrap: wrap;
  }

  .nav-demo-tabs {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .nav-demo-tab {
    padding: 0.35rem 0.85rem;
    font-size: 0.82rem;
    font-weight: 500;
    border-radius: 6px;
    background: transparent;
    border: 1px solid transparent;
    color: var(--muted);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .nav-demo-tab:hover {
    color: var(--ink);
    background: var(--paper-card);
  }

  .nav-demo-tab.is-active {
    background: var(--paper-card);
    color: var(--cobalt);
    border-color: var(--border-subtle);
    font-weight: 600;
    box-shadow: 0 1px 4px rgba(9, 13, 22, 0.06);
  }

  .nav-demo-tag {
    font-size: 0.76rem;
    color: var(--muted);
    font-family: var(--mono);
    font-weight: 500;
  }

  .nav-stage {
    padding: 1.5rem;
    min-height: 380px;
    background: var(--paper);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .stage-view {
    display: none;
    width: 100%;
    animation: fadeInView 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .stage-view.is-visible {
    display: block;
  }

  @keyframes fadeInView {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Mockup Window Chrome */
  .mockup-chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    background: var(--paper-2);
    border: 1px solid var(--border);
    border-bottom: none;
    border-radius: 8px 8px 0 0;
  }

  .chrome-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .chrome-dot.red { background: #ef4444; }
  .chrome-dot.yellow { background: #f59e0b; }
  .chrome-dot.green { background: #10b981; }

  .chrome-address {
    margin-left: 10px;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--muted);
    opacity: 0.8;
  }

  /* Topbar Mockup */
  .stage-topbar .mockup-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 18px;
    background: var(--paper-card);
    border: 1px solid var(--border);
  }

  .topbar-brand {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .topbar-logo-sq {
    width: 22px;
    height: 22px;
    background: var(--cobalt);
    border-radius: 5px;
  }

  .topbar-title {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--ink);
  }

  .topbar-nav {
    display: flex;
    gap: 16px;
  }

  .topbar-link {
    font-size: 0.82rem;
    color: var(--muted);
    font-weight: 500;
    cursor: default;
  }

  .topbar-link.is-active {
    color: var(--cobalt);
    font-weight: 600;
  }

  .topbar-user {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .topbar-search-mock {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    background: var(--paper-2);
    border-radius: 6px;
    font-size: 0.75rem;
    color: var(--muted);
  }

  .topbar-avatar {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--rose-soft);
    color: var(--cobalt);
    font-size: 0.72rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .topbar-content-mock {
    padding: 20px;
    background: var(--paper);
    border: 1px solid var(--border);
    border-top: none;
    border-radius: 0 0 8px 8px;
  }

  .mock-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 14px;
  }

  .mock-card {
    height: 80px;
    background: var(--paper-card);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
  }

  .mock-card.h-large {
    height: 120px;
  }

  /* Sidebar SaaS Mockup */
  .mockup-sidebar-layout {
    display: flex;
    border: 1px solid var(--border);
    border-radius: 0 0 8px 8px;
    overflow: hidden;
    min-height: 260px;
    background: var(--paper-card);
  }

  .mock-sidebar {
    width: 200px;
    background: var(--paper-2);
    border-right: 1px solid var(--border-subtle);
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex-shrink: 0;
  }

  .sidebar-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--ink);
  }

  .sidebar-section-title {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    color: var(--muted);
    margin: 8px 0 2px 4px;
  }

  .sidebar-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 8px;
    border-radius: 6px;
    font-size: 0.8rem;
    color: var(--muted);
    font-weight: 500;
  }

  .sidebar-item.is-active {
    background: var(--paper-card);
    color: var(--cobalt);
    font-weight: 600;
    box-shadow: 0 1px 3px rgba(9, 13, 22, 0.06);
  }

  .sidebar-pill {
    margin-left: auto;
    font-size: 0.65rem;
    padding: 1px 6px;
    border-radius: 999px;
    background: var(--paper-2);
    font-weight: 600;
  }

  .sidebar-pill.alert {
    background: var(--rose-soft);
    color: var(--cobalt);
  }

  .mock-main-body {
    flex: 1;
    padding: 16px;
    background: var(--paper);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .mock-banner {
    height: 48px;
    background: var(--paper-card);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
  }

  /* Phone Bottom Nav Mockup */
  .stage-bottomnav {
    display: flex;
    justify-content: center;
  }

  .phone-frame {
    width: 280px;
    height: 380px;
    background: var(--paper-card);
    border: 3px solid var(--border);
    border-radius: 28px;
    padding: 8px;
    box-shadow: var(--card-shadow);
    margin: 0 auto;
  }

  .phone-screen {
    width: 100%;
    height: 100%;
    background: var(--paper);
    border-radius: 20px;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
  }

  .phone-speaker {
    width: 48px;
    height: 4px;
    background: var(--border);
    border-radius: 2px;
    margin: 4px auto 0 auto;
  }

  .phone-topbar {
    display: flex;
    justify-content: space-between;
    padding: 4px 14px;
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--muted);
  }

  .phone-content {
    flex: 1;
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .phone-hero-card {
    padding: 12px;
    background: var(--paper-card);
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
  }

  .phone-tag {
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--cobalt);
  }

  .phone-hero-card h4 {
    margin: 2px 0 4px 0;
    font-size: 0.85rem;
  }

  .phone-hero-card p {
    margin: 0;
    font-size: 0.72rem;
    color: var(--muted);
  }

  .mock-card-sm {
    height: 38px;
    background: var(--paper-card);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
  }

  .phone-bottom-bar {
    display: flex;
    justify-content: space-around;
    padding: 8px 6px;
    background: var(--paper-card);
    border-top: 1px solid var(--border-subtle);
  }

  .phone-nav-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    font-size: 0.62rem;
    color: var(--muted);
    font-weight: 500;
  }

  .phone-nav-item.is-active {
    color: var(--cobalt);
    font-weight: 700;
  }

  /* Empty State Mockup */
  .empty-state-card {
    max-width: 460px;
    margin: 0 auto;
    text-align: center;
    padding: 2.2rem 1.8rem;
    background: var(--paper-card);
    border: 1px solid var(--border);
    border-radius: 12px;
  }

  .empty-state-illustration {
    margin-bottom: 1.25rem;
  }

  .empty-state-card h4 {
    margin: 0 0 0.5rem 0;
    font-size: 1.15rem;
    color: var(--ink);
  }

  .empty-state-card p {
    margin: 0 0 1.5rem 0;
    font-size: 0.88rem;
    color: var(--muted);
    line-height: 1.5;
  }

  .empty-state-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
  }

  .btn-empty-primary {
    padding: 0.6rem 1.2rem;
    background: var(--cobalt);
    color: #fff;
    border: none;
    border-radius: 8px;
    font-size: 0.84rem;
    font-weight: 600;
    cursor: pointer;
  }

  .btn-empty-secondary {
    padding: 0.6rem 1.2rem;
    background: var(--paper-2);
    color: var(--ink);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    font-size: 0.84rem;
    font-weight: 600;
    cursor: pointer;
  }
</style>

<script>
  function setupNavDemo() {
    const tabs = document.querySelectorAll('.nav-demo-tab');
    const views = document.querySelectorAll('.stage-view');
    const tagEl = document.getElementById('nav-demo-tag');

    const metaDescriptions: Record<string, string> = {
      topbar: 'Resolucion: Escritorio / Web &bull; Menos de 6 destinos &bull; Contenido transversal',
      sidebar: 'Resolucion: Escritorio &bull; Dashboards SaaS y jerarquias profundas',
      bottomnav: 'Resolucion: Movil (Viewport estrecho) &bull; 48px area de toque &bull; Zona del pulgar',
      emptystate: 'Patron de feedback visual cuando no existen datos o registros en pantalla'
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => {
          t.classList.remove('is-active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('is-active');
        tab.setAttribute('aria-selected', 'true');

        const model = (tab as HTMLElement).dataset.model || 'topbar';
        views.forEach((v) => {
          v.classList.remove('is-visible');
        });

        const targetView = document.getElementById(`view-${model}`);
        targetView?.classList.add('is-visible');

        if (tagEl && metaDescriptions[model]) {
          tagEl.innerHTML = metaDescriptions[model];
        }
      });
    });
  }

  setupNavDemo();
  document.addEventListener('astro:page-load', setupNavDemo);
</script>
