---
// Interactive Before / After Design System Split Slider
---

<div class="split-slider-container reveal-on-scroll" id="before-after-slider">
  <!-- LAYER BEFORE (SIN DESIGN SYSTEM) -->
  <div class="split-slider-layer split-layer-before">
    <div class="split-badge">Sin Sistema (Ad-hoc)</div>
    <div style="max-width: 420px; width: 100%; border: 1px dashed #d97706; padding: 22px; background: #fff; font-family: 'Times New Roman', serif;">
      <h3 style="color: #b91c1c; font-size: 1.8rem; margin-bottom: 7px; font-family: inherit;">Bienvenido al Portal</h3>
      <p style="font-size: 14.5px; line-height: 1.3; color: #444; margin-bottom: 13px;">
        Espacios arbitrarios (13px, 7px, 21px). Cinco tonos de azul distintos en la misma vista y botones sin estados de foco.
      </p>
      <div style="display: flex; gap: 7px;">
        <button type="button" style="background: #2563eb; color: #fff; border: 3px double #000; padding: 4px 11px; font-size: 13px; cursor: pointer;">
          Aceptar
        </button>
        <button type="button" style="background: #10b981; color: #fff; border: 1px dotted #333; padding: 9px 18px; font-size: 15px; cursor: pointer;">
          Cancelar
        </button>
      </div>
      <span style="display:inline-block; margin-top: 15px; font-size: 10px; background: #fef08a; padding: 2px 6px; color: #000;">
        Estilo no documentado
      </span>
    </div>
  </div>

  <!-- LAYER AFTER (CON DESIGN SYSTEM) -->
  <div class="split-slider-layer split-layer-after" id="split-layer-after">
    <div class="split-badge">Con Sistema (Tokens &amp; Grid)</div>
    <div style="max-width: 420px; width: 100%; border: 2px solid var(--ink); padding: 24px; background: var(--paper); font-family: var(--sans); border-radius: 8px; box-shadow: 0 10px 25px rgba(0,0,0,0.25); color: var(--ink);">
      <h3 style="font-size: 1.6rem; margin-bottom: 8px; font-family: var(--serif); color: var(--ink);">Bienvenido al Atlas</h3>
      <p style="font-size: 0.95rem; line-height: 1.55; color: var(--muted); margin-bottom: 20px;">
        Malla base de 8px estricta, tokens semánticos auditados contra WCAG 2.2 y jerarquía tipográfica calculada.
      </p>
      <div style="display: flex; gap: 12px; align-items: center;">
        <button type="button" class="btn" style="border-radius: 6px;">
          Confirmar
        </button>
        <button type="button" style="background: transparent; color: var(--ink); border: 2px solid var(--ink); border-radius: 6px; padding: 8px 16px; font: 700 0.95rem var(--sans); cursor: pointer;">
          Descartar
        </button>
      </div>
      <span class="tag" style="border-radius: 4px; margin-top: 16px;">Token: --space-md</span>
    </div>
  </div>

  <!-- SLIDER HANDLE -->
  <div class="split-handle" id="split-handle">
    <div class="split-handle-btn" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" style="margin-left: -4px;">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </div>
  </div>

  <!-- ACCESSIBLE RANGE INPUT -->
  <input
    type="range"
    id="split-range-input"
    class="split-range-input"
    min="0"
    max="100"
    value="50"
    aria-label="Deslizar entre vista sin sistema y vista con sistema"
  />
</div>

<script>
  function setupBeforeAfterSlider() {
    const sliderContainer = document.getElementById('before-after-slider');
    const rangeInput = document.getElementById('split-range-input') as HTMLInputElement | null;
    const afterLayer = document.getElementById('split-layer-after');
    const handle = document.getElementById('split-handle');

    if (!sliderContainer || !rangeInput || !afterLayer || !handle) return;

    const layer = afterLayer;
    const h = handle;
    let rafId: number | null = null;

    function updateSplit(pct: number) {
      layer.style.clipPath = `inset(0 0 0 ${pct}%)`;
      h.style.left = `${pct}%`;
    }

    rangeInput.addEventListener('input', () => {
      if (rafId !== null) cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(() => {
        const val = parseFloat(rangeInput.value);
        updateSplit(val);
        rafId = null;
      });
    });

    updateSplit(50);
  }

  setupBeforeAfterSlider();
  document.addEventListener('astro:page-load', setupBeforeAfterSlider);
</script>
